# ---- Database (Neon PostgreSQL) ----
# Get this from https://console.neon.tech -> your project -> Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/wp_prospector?sslmode=require"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Single admin login (replace with a real users table for multi-user).
ADMIN_EMAIL="admin@wpprospector.com"
ADMIN_PASSWORD="change-me"

# ---- AI Classification + Sales Assistant ----
# Which provider powers classification & copy generation: "openai" | "gemini" | "mock"
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---- Discovery (find WordPress contractor sites) ----
# Which search provider finds candidate domains: "serper" | "google" | "mock"
# "mock" runs the funnel offline but returns no live candidates.
DISCOVERY_PROVIDER="serper"
# Serper.dev (Google Search API) — https://serper.dev
SERPER_API_KEY=""
# Or Google Programmable Search (Custom Search JSON API)
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# ---- Email enrichment (Hunter.io) ----
# Optional. When set, scans auto-find a contact email for sites that don't
# expose one on their homepage (Hunter Domain Search). https://hunter.io
HUNTER_API_KEY=""

# ---- Outreach (Resend) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="prospecting@wpprospector.com"
