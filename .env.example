# Copy to .env for local work. CI sets what it needs itself, see .github/workflows/ci.yml.
# Never commit a filled in .env.
#
# This application has no server, no database, and no third party credentials today
# (docs/production/INVENTORY.md). Nothing here is a secret yet. Every secret added later
# must also be listed in .github/scripts/server-only-vars.txt so the client bundle check
# can catch it leaking into the browser.

# Set to "true" to build with the GitHub Pages basePath (/seo-manager-os). See next.config.mjs.
GITHUB_PAGES="false"

# Base URL the Playwright suites point at. scripts/serve-export.mjs serves out/ here.
TEST_BASE_URL="http://localhost:3000"
