# ---- Database (Neon PostgreSQL) ----
# Get this from https://console.neon.tech -> your project -> Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/wp_prospector?sslmode=require"

# ---- Scheduler (Vercel Cron) ----
# Secures the cron route that auto-runs due campaigns. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate: openssl rand -base64 32
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Single admin login (replace with a real users table for multi-user).
ADMIN_EMAIL="admin@wpprospector.com"
ADMIN_PASSWORD="change-me"

# ---- AI Classification + Sales Assistant ----
# Which provider powers classification & copy generation: "openai" | "gemini" | "mock"
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---- Discovery (find WordPress contractor sites) ----
# Where candidate domains come from: "serper" | "google" | "hunter" | "mock"
#   serper/google -> web search by "trade + City, ST"
#   hunter        -> Hunter Discover (technology=wordpress + location); needs a
#                    paid Hunter plan with advanced Discover filters + HUNTER_API_KEY
#   mock          -> runs the funnel offline, returns no live candidates
DISCOVERY_PROVIDER="serper"
# Serper.dev (Google Search API) — https://serper.dev
SERPER_API_KEY=""
# Or Google Programmable Search (Custom Search JSON API)
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
# Optional: narrow Hunter Discover server-side using Hunter's industry taxonomy
# (comma-separated, e.g. "Construction,Consumer Services"). Left blank, we pull
# WordPress sites by location and classify the trade ourselves.
HUNTER_DISCOVER_INDUSTRIES=""

# ---- Email enrichment (Hunter.io) ----
# Optional. When set, scans auto-find a contact email for sites that don't
# expose one on their homepage (Hunter Domain Search). https://hunter.io
HUNTER_API_KEY=""

# ---- Outreach (Resend) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="prospecting@wpprospector.com"
