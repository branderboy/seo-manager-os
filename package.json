{
  "name": "seo-manager-os",
  "version": "0.1.0",
  "private": true,
  "description": "SEO Manager OS \u2014 an SEO investigation, diagnosis, strategy, and execution operating system for local, SaaS, and enterprise search.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:export": "node scripts/serve-export.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:authz": "vitest run --config vitest.integration.config.ts tests/integration/tenant-isolation.spec.ts",
    "test:e2e": "playwright test tests/e2e/critical-workflows.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "db:test:setup": "bash scripts/db-test-setup.sh"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "pg": "^8.23.0",
    "playwright-core": "^1.49.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
